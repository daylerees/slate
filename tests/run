#!/usr/bin/env bash
# Slate's tests: one command for all of them, run in a container so nothing touches your
# desktop. See docs/TESTING.md.
#
#   tests/run                      every tier, in the container
#   tests/run -q                   only failures and a summary line (for agents and hooks)
#   tests/run --tier static,unit   just these tiers (static, unit, live, visual, all)
#   tests/run --no-container       static + unit straight on this machine (fast)
#   tests/run --filter dock        only tests whose name contains "dock"
#   tests/run --failed             only the tests that failed last time (tests/out/failed.txt;
#                                  a failed subtest runs its whole test again)
#   tests/run --repeat 5           run the chosen tests 5 times over, then list only what didn't
#                                  pass every time (each run's logs: tests/out/repeat/<run>/)
#   tests/run --jobs 3             how many Slate sessions run side by side (default: half
#                                  this machine's processors, 4 at most; 1 = one after another)
#   tests/run --deps latest        build the image from today's Arch packages, not the pinned date
#                                  (once a day: run again the same day, it shows that result)
#   tests/run --deps latest --fresh   run it again anyway
#   tests/run --approve [scene…]   approve the changed screenshots the last run took (all, or
#                                  these), once you've looked at them: nothing is run again.
#                                  A visual run with changes writes tests/out/visual/review.html
#                                  to look at them on: each scene's approved picture, the new one
#                                  and the difference, with tick boxes for the --approve line
#   tests/run --update-baselines [scene…]   re-shoot approved screenshots (all, or these)
#   tests/run --json               one JSON line per failure, then a summary
#   tests/run -v                   list every check, passes too
#
# Exit code 0 only when everything ran and passed. Logs, failure screenshots and diffs go
# in tests/out/. The live and visual tiers need the vkms kernel module (sudo modprobe vkms).
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUT="${SLATE_TEST_OUT:-$ROOT/tests/out}"
tier=all; deps=pinned; container=1; update=""; updating=0; fresh=0; filtered=0; jobs=""; failed=0
repeat=""; pass=(); again=()      # (again: the options for each run of a --repeat)
while [ $# -gt 0 ]; do
    case "$1" in
        --repeat|--repeat=*|-q|--quiet|-v|--verbose|--json) ;;
        --tier|--deps|--filter|--jobs) again+=("$1" "${2-}") ;;
        *) again+=("$1") ;;
    esac
    case "$1" in
        --tier) tier=$2; shift ;;
        --tier=*) tier=${1#*=} ;;
        --deps) deps=$2; shift ;;
        --deps=*) deps=${1#*=} ;;
        --no-container) container=0 ;;
        --filter) pass+=(--filter "$2"); filtered=1; shift ;;
        --filter=*) pass+=(--filter "${1#*=}"); filtered=1 ;;
        --fresh) fresh=1 ;;
        --failed) failed=1 ;;
        --jobs) jobs=$2; shift ;;
        --jobs=*) jobs=${1#*=} ;;
        --repeat) repeat=$2; shift ;;
        --repeat=*) repeat=${1#*=} ;;
        -q|--quiet|-v|--verbose|--json) pass+=("$1") ;;
        --approve) shift; exec python3 "$ROOT/tests/visual/approve.py" "$@" ;;
        --update-baselines)
            updating=1
            while [ $# -gt 1 ] && [ "${2#-}" = "$2" ]; do update="$update $2"; shift; done ;;
        -h|--help) sed -n '2,/^set/{/^set/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
        *) echo "tests/run: unknown option $1 (see tests/run --help)" >&2; exit 2 ;;
    esac
    shift
done
case "$jobs" in ""|[1-9]|[1-9][0-9]) ;; *) echo "tests/run: --jobs is a number, 1 or more" >&2; exit 2 ;; esac
case "$deps" in pinned|latest) ;; *) echo "tests/run: --deps is pinned or latest" >&2; exit 2 ;; esac
case "$repeat" in ""|[1-9]|[1-9][0-9]|[1-9][0-9][0-9]) ;; *) echo "tests/run: --repeat is a number, 1 or more" >&2; exit 2 ;; esac
if [ -n "$repeat" ] && [ "$updating" = 1 ]; then
    echo "tests/run: --repeat doesn't go with --update-baselines" >&2; exit 2
fi
if [ "$updating" = 1 ]; then
    [ "$tier" = all ] && tier=visual
    export SLATE_UPDATE_BASELINES="${update# }"
    [ -n "$SLATE_UPDATE_BASELINES" ] || SLATE_UPDATE_BASELINES=all
fi
# Only what failed last time: its tiers, and the runner picks its tests from tests/out/failed.txt
if [ "$failed" = 1 ]; then
    if ! grep -q '^tests\.' "$OUT/failed.txt" 2>/dev/null; then
        echo "Nothing to run again: the last run had no failures."
        exit 0
    fi
    tier=""
    for t in static unit live visual; do
        grep -q "^tests\.$t\." "$OUT/failed.txt" && tier="$tier${tier:+,}$t"
    done
    pass+=(--failed); filtered=1
fi
# Several runs: tests/lib/repeat.py starts this again for each (with a tests/out of its own,
# reporting in --json) and adds them up
if [ -n "$repeat" ]; then
    modes=(); for a in "${pass[@]+"${pass[@]}"}"; do case "$a" in -q|--quiet|-v|--verbose|--json) modes+=("$a") ;; esac; done
    mkdir -p "$OUT"
    exec python3 "$ROOT/tests/lib/repeat.py" --times "$repeat" --out "$OUT" "${modes[@]+"${modes[@]}"}" \
        -- "$0" "${again[@]+"${again[@]}"}"
fi
quiet=0; for a in "${pass[@]+"${pass[@]}"}"; do case "$a" in -q|--quiet|--json) quiet=1 ;; esac; done
say() { [ "$quiet" = 1 ] || echo "$@" >&2; }
mkdir -p "$OUT"

if [ "$container" = 0 ]; then
    [ "$tier" = all ] && tier=static,unit
    case ",$tier," in *,live,*|*,visual,*)
        echo "tests/run: the live and visual tiers only run in the container (leave out --no-container)" >&2; exit 2 ;;
    esac
    exec python3 "$ROOT/tests/lib/runner.py" --tier "$tier" "${pass[@]+"${pass[@]}"}"
fi

# Latest packages: once a day locally (a day's packages don't change, and it takes a while).
# The day's result is kept per tier; a filtered run, a baseline update or CI always runs
cache=""
if [ "$deps" = latest ] && [ "$filtered" = 0 ] && [ "$updating" = 0 ] && [ -z "${CI:-}" ]; then
    cache="$OUT/latest-${tier//,/-}.txt"
    if [ "$fresh" = 0 ] && [ -f "$cache" ] && [ "$(head -1 "$cache" | cut -d' ' -f1)" = "$(date +%F)" ]; then
        echo "tests/run: already ran with today's packages (tests/run --deps latest --fresh to run again):" >&2
        tail -n +2 "$cache"
        exit "$(head -1 "$cache" | cut -d' ' -f2)"
    fi
fi

command -v docker >/dev/null || { echo "tests/run: Docker isn't installed (or use --no-container for static + unit)" >&2; exit 2; }

# The image: rebuilt when its recipe changes (pinned), or once a day (latest)
ctx=$(mktemp -d); trap 'rm -rf "$ctx"' EXIT
cp "$ROOT/tests/container/Dockerfile" "$ROOT/tests/container/entry.sh" "$ROOT/packaging/arch.txt" "$ctx/"
snapshot=$(grep -v '^\s*\(#\|$\)' "$ROOT/tests/container/deps.lock" | head -1)
recipe=$(cat "$ctx"/* "$ROOT/tests/container/deps.lock" | sha256sum | cut -c1-12)
if [ "$deps" = pinned ]; then
    image="slate-tests:pinned-$recipe"; build_args=(--build-arg "SNAPSHOT=$snapshot")
else
    image="slate-tests:latest-$(date +%Y%m%d)-$recipe"; build_args=(--pull --no-cache)
fi
if ! docker image inspect "$image" >/dev/null 2>&1; then
    say "Building the test image ($deps deps$([ "$deps" = pinned ] && echo ", $snapshot")): a few minutes, once…"
    # (CI adds its layer cache through SLATE_TEST_BUILD_ARGS)
    # shellcheck disable=SC2086
    if ! docker build "${build_args[@]}" ${SLATE_TEST_BUILD_ARGS:-} -t "$image" "$ctx" >"$OUT/image-build.log" 2>&1; then
        echo "tests/run: building the test image failed; see tests/out/image-build.log" >&2
        tail -5 "$OUT/image-build.log" >&2
        exit 2
    fi
fi

# The live and visual tiers: Hyprland renders (in software) through a vkms device
run_args=()
case ",$tier," in *,live,*|*,visual,*|*,all,*)
    card=""
    for c in /sys/class/drm/card[0-9]*; do
        [ -e "$c/device/driver" ] || continue
        case "$(readlink -f "$c/device/driver")" in *vkms*|*faux*) card=/dev/dri/$(basename "$c"); break ;; esac
    done
    if [ -z "$card" ]; then
        echo "tests/run: the live and visual tiers need the vkms kernel module. Load it with:" >&2
        echo "    sudo modprobe vkms" >&2
        echo "(or run only --tier static,unit)" >&2
        exit 2
    fi
    run_args+=(--device "$card" -e "SLATE_TEST_CARD=$card" -e "DRI_GID=$(stat -c %g "$card")")
    ;;
esac

label=""; [ "$deps" = latest ] && label="[latest deps]"
if [ "$updating" = 1 ]; then
    mkdir -p "$ROOT/tests/visual/baselines"
    run_args+=(-v "$ROOT/tests/visual/baselines:/slate/tests/visual/baselines")
    rm -f "$OUT/visual/updated.txt"
fi
status=0
[ -n "$cache" ] && exec 3>&1 && exec > >(tee "$cache.part" >&3)
# How many sessions at once: half the processors (each session draws in software, which is
# heavy on them), four at most. One after another on CI, and when re-shooting screenshots
if [ -z "$jobs" ]; then
    jobs=$(( $(nproc 2>/dev/null || echo 2) / 2 ))
    [ "$jobs" -gt 4 ] && jobs=4
    [ "$jobs" -lt 1 ] && jobs=1
    [ -n "${CI:-}" ] && jobs=1
fi
[ "$updating" = 1 ] && jobs=1
# (static and unit are one part however many jobs there are, so they run as they always did)
case ",$tier," in *,live,*|*,visual,*|*,all,*) ;; *) jobs=1 ;; esac
runner=(docker run --rm --init --hostname slate-test
    -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)"
    -e SLATE_UPDATE_BASELINES="${SLATE_UPDATE_BASELINES:-}"
    -v "$ROOT:/slate:ro" -v "$OUT:/slate/tests/out" -w /slate
    # (the container shares the host's /sys: without this, the host's keyboard lights, Caps Lock
    # among them, showed up on the lock and login screens and changed their screenshots)
    --mount type=tmpfs,destination=/sys/class/leds
    "${run_args[@]+"${run_args[@]}"}"
    "$image" python3 /slate/tests/lib/runner.py)
if [ "$jobs" = 1 ]; then
    "${runner[@]}" --tier "$tier" --label "$label" "${pass[@]+"${pass[@]}"}" || status=$?
else
    # Side by side: tests/lib/parallel.py starts a container per part and adds up the results
    SLATE_TEST_OUT="$OUT" python3 "$ROOT/tests/lib/parallel.py" --jobs "$jobs" --tier "$tier" --label "$label" \
        "${pass[@]+"${pass[@]}"}" -- "${runner[@]}" || status=$?
fi
if [ -n "$cache" ]; then
    exec >&3 3>&-; wait $! 2>/dev/null || true
    { echo "$(date +%F) $status"; cat "$cache.part"; } > "$cache"; rm -f "$cache.part"
fi
# Changed screenshots: one page to look at them all and pick the ones to approve
case ",$tier," in *,visual,*|*,all,*)
    if [ "$updating" = 0 ] && page=$(SLATE_TEST_OUT="$OUT" python3 "$ROOT/tests/visual/review.py") && [ -n "$page" ]; then
        echo "Changed screenshots, to look at and approve: $page" >&2
    fi ;;
esac
if [ "$updating" = 1 ]; then
    if [ -s "$OUT/visual/updated.txt" ]; then
        echo "Approved screenshots updated (review them with git diff before committing):"
        sed 's/^/  /' "$OUT/visual/updated.txt"
    else
        echo "No approved screenshots changed."
    fi
fi
exit $status
