#!/usr/bin/env bash
# Unlocking without the password (Settings → Security; LockScreen.qml's other way in): which
# of a face, a fingerprint and a security key the lock screen takes, kept in a PAM service of
# Slate's own, /etc/pam.d/slate-lock. Nothing else on the computer (sudo, logging in at a
# terminal, other apps, the login screen) reads that file, so nothing else changes.
#
# It runs from /usr/local/libexec/slate, a root-owned copy (bin/slate-helpers-install puts it
# there), by slate-system --root (pkexec, your password); never from your Slate folder, which
# anything running as you could change.
#
#   slate-unlock enable <method>    the lock screen takes it (face, fingerprint or key)
#   slate-unlock disable <method>   it doesn't any more; with none left the file goes
#   slate-unlock remove             none at all: the file goes, and the security keys' list
#                                   (uninstalling, factory reset)
#   slate-unlock status             the methods it takes, one a line (anyone can read the file)
#   slate-unlock face-camera <device>   the camera Howdy looks through (/dev/v4l/by-id/…, …)
#   slate-unlock face-models        get Howdy's recognition models, when it hasn't any yet
#   slate-unlock face-add <label> [device]
#                                   add your face (Howdy looks through the camera): through that
#                                   camera from now on, when one's given, and with Howdy's models
#                                   got first if it hasn't any; then your faces, as face-list
#   slate-unlock face-remove <id>   remove one of your faces; then your faces, as face-list
#   slate-unlock face-list          your faces, "<id>,<date>,<label>" a line
#   slate-unlock key-add <registration>
#                                   add one of your security keys: pamu2fcfg -n's line for it
#                                   ("<handle>,<public key>,<type>,<flags>", made as you, touching
#                                   the key); then your keys, as key-list
#   slate-unlock key-remove <n>     remove your nth key; then your keys, as key-list
#   slate-unlock key-list           your keys, "<n>,<handle>" a line (anyone can read the file)
#   slate-unlock login-enable <method>
#   slate-unlock login-disable <method>
#                                   the same on Slate's login screen: /etc/pam.d/slate-greetd,
#                                   which Slate's greetd config uses (only Slate's: exits 4 when
#                                   greetd's config isn't the one Slate's login screen wrote)
#   slate-unlock login-status       the methods Slate's login screen takes, one a line
#   slate-unlock --table            each method and the PAM modules it can be (the tests)
#
# Faces are Howdy's (Howdy Next 3): kept in /etc/howdy, root's, so adding, removing and even
# listing them is root's to do. Always the faces of whoever asked (pkexec's PKEXEC_UID), never
# a name given here; Howdy only ever from a root-owned file in a fixed place.
#
# Security keys are pam_u2f's, in /etc/slate/u2f_keys: "<user>:<key>:<key>…" a line, root's, never
# in your home (where anything running as you could add one). Anyone can read it: it holds only
# public keys, and the lock screen's PAM runs as you. Only the lines of whoever asked change.
#
# The file is only ever these methods, each "sufficient", then pam_deny (nothing else gets in
# through it), and the account checked as `login` does: the password is never in it, as the
# lock screen asks for that through `login` itself, so a lost key or a camera that can't see
# you never locks you out. A method's line comes from a fixed list of root-owned module paths,
# and only once its module is installed. Exits 3 when a method's module isn't installed.
#
# The login screen's service is greetd's own with the methods put first: nologin's check (no
# logins while the computer's shutting down), then each method "sufficient", then everything in
# greetd's own service (the password and the rest: account, session). greetd has one
# conversation, so the methods run before the password and it comes once they give up; the
# fingerprint's tries are kept short there. Once written, the file is only ever rewritten, never
# taken away: greetd reads which service to use as it starts, and goes on using it until the
# computer restarts, so with no methods it's simply greetd's own again.
set -uo pipefail
umask 022

TARGET_DIR=/usr/local/libexec/slate
PAMD=/etc/pam.d
FILE=$PAMD/slate-lock
KEYS=/etc/slate/u2f_keys            # security keys (pam_u2f's authfile)
LOGIN_FILE=$PAMD/slate-greetd       # Slate's login screen's service (greetd's own, methods first)
GREETD_CONF=/etc/greetd/config.toml
MARK="# slate-unlock:"
METHODS="face fingerprint key"
# Where each method's PAM module can be, first found wins: "<module file> <line's module part>"
# (Howdy 3 has pam_howdy.so; Howdy 2 is a pam_python script. pam_u2f's keys are in a file root
# owns, never in your home, for Settings to manage)
candidates() {
    local d
    for d in /usr/lib/security /usr/lib64/security /lib/security /lib64/security \
             /usr/lib/x86_64-linux-gnu/security /lib/x86_64-linux-gnu/security /usr/lib/aarch64-linux-gnu/security; do
        case "$1" in
            face) echo "$d/pam_howdy.so pam_howdy.so"
                  echo "$d/howdy/pam.py pam_python.so $d/howdy/pam.py" ;;
            fingerprint) echo "$d/pam_fprintd.so pam_fprintd.so" ;;
            key) echo "$d/pam_u2f.so pam_u2f.so authfile=$KEYS cue" ;;
        esac
    done
}

if [ "${1:-}" = --table ]; then
    for m in $METHODS; do candidates "$m" | while read -r file rest; do echo "$m $file $rest"; done; done
    exit 0
fi
if [ "${1:-}" = status ]; then
    [ -f "$FILE" ] && [ ! -L "$FILE" ] && sed -n "s/^$MARK //p" "$FILE"
    exit 0
fi
if [ "${1:-}" = login-status ]; then
    [ -f "$LOGIN_FILE" ] && [ ! -L "$LOGIN_FILE" ] && sed -n "s/^$MARK //p" "$LOGIN_FILE"
    exit 0
fi

[ "$(dirname "$(readlink -f "$0")")" = "$TARGET_DIR" ] || {
    echo "slate-unlock: this only runs from $TARGET_DIR (bin/slate-system --root slate-unlock)" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || { echo "slate-unlock: this is run as root (by slate-system --root)" >&2; exit 1; }
[ -d "$PAMD" ] && [ ! -L "$PAMD" ] || { echo "slate-unlock: $PAMD isn't a folder here" >&2; exit 1; }
[ ! -L "$FILE" ] || { echo "slate-unlock: $FILE is a link: not touching it" >&2; exit 1; }
[ ! -e "$FILE" ] || [ -f "$FILE" ] || { echo "slate-unlock: $FILE isn't a plain file: not touching it" >&2; exit 1; }

known() { case " $METHODS " in *" $1 "*) return 0 ;; esac; return 1; }

# ---- Faces (Howdy) -------------------------------------------------------------------------
HOWDY_PATHS="/usr/bin/howdy /usr/local/bin/howdy"
HOWDY_MODELS=/usr/share/howdy/models
# Howdy, if it's here: a root-owned program, not writable by anyone else
howdy_bin() {
    local h
    for h in $HOWDY_PATHS; do
        [ -f "$h" ] && [ ! -L "$h" ] && [ "$(stat -c %u "$h")" = 0 ] && [ -z "$(find "$h" -perm /022)" ] && { echo "$h"; return 0; }
    done
    return 1
}
# ---- Security keys (pam_u2f) ----------------------------------------------------------------
MAX_KEYS=10
# Your keys, one a line. Your line is the one whose first field is exactly your name (a grep
# pattern would let the dot in j.doe match jxdoe's line too)
keys_of() { [ -f "$KEYS" ] && awk -F: -v u="$1" '$1 == u { sub(/^[^:]*:/, ""); print; exit }' "$KEYS" | tr ':' '\n' | grep -v '^$'; }
# The file again, your line as given (none: gone), everyone else's as they were; all at once
write_keys() {   # write_keys <user> <key>…
    local user="$1" dir tmp; shift
    dir=$(dirname "$KEYS")
    [ ! -L "$dir" ] || { echo "slate-unlock: $dir is a link: not touching it" >&2; return 1; }
    mkdir -p "$dir" && chmod 0755 "$dir" || return 1
    [ ! -L "$KEYS" ] && { [ ! -e "$KEYS" ] || [ -f "$KEYS" ]; } || { echo "slate-unlock: $KEYS isn't a plain file: not touching it" >&2; return 1; }
    tmp=$(mktemp "$dir/.u2f_keys.XXXXXX") || return 1
    {
        [ -f "$KEYS" ] && awk -F: -v u="$user" '$1 != u' "$KEYS"
        if [ "$#" -gt 0 ]; then (IFS=:; echo "$user:$*"); fi
    } > "$tmp"
    chown root:root "$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$KEYS" || { rm -f "$tmp"; return 1; }
}
list_keys() { local n=0 k; while read -r k; do n=$((n + 1)); echo "$n,${k%%,*}"; done < <(keys_of "$1"); }
key() {   # key <action> [arg]
    local user reg k have=() n i
    user=$(asker) || return 1
    mapfile -t have < <(keys_of "$user")
    case "$1" in
        key-add)
            reg=${2#:}
            [[ "$reg" =~ ^[A-Za-z0-9+/=_-]{16,1024},[A-Za-z0-9+/=_-]{16,1024},(es256|eddsa|rs256),[+a-z]{0,40}$ ]] || {
                echo "slate-unlock: that isn't a security key's registration" >&2; return 1; }
            for k in "${have[@]}"; do
                [ "${k%%,*}" != "${reg%%,*}" ] || { echo "slate-unlock: that key's already added" >&2; return 1; }
            done
            [ "${#have[@]}" -lt "$MAX_KEYS" ] || { echo "slate-unlock: you have $MAX_KEYS keys already" >&2; return 1; }
            write_keys "$user" "${have[@]}" "$reg" || return 1 ;;
        key-remove)
            [[ "$2" =~ ^[0-9]{1,3}$ ]] && [ "$2" -ge 1 ] && [ "$2" -le "${#have[@]}" ] || { echo "slate-unlock: no key $2" >&2; return 1; }
            n=$2; local keep=()
            for i in "${!have[@]}"; do [ $((i + 1)) -eq "$n" ] || keep+=("${have[$i]}"); done
            write_keys "$user" "${keep[@]}" || return 1 ;;
    esac
    list_keys "$user"
}
# Whose faces (or keys): the account that asked (pkexec says), as a name
asker() {
    local uid="${PKEXEC_UID:-}"
    case "$uid" in ''|*[!0-9]*) echo "slate-unlock: faces are changed through pkexec (slate-system --root)" >&2; return 1 ;; esac
    [ "$uid" -ne 0 ] || { echo "slate-unlock: not root's faces" >&2; return 1; }
    getent passwd "$uid" | cut -d: -f1 | grep -E '^[a-z_][a-z0-9_.-]*[$]?$'
}
# The camera Howdy looks through: a video device, by its stable name or as /dev/videoN, never a
# link out of /dev
set_camera() {   # set_camera <howdy> <device>
    case "$2" in
        /dev/v4l/by-id/*|/dev/v4l/by-path/*) [[ "$2" =~ ^/dev/v4l/by-(id|path)/[A-Za-z0-9_.:-]+$ ]] || { echo "slate-unlock: not a camera: $2" >&2; return 1; } ;;
        /dev/video[0-9]|/dev/video[0-9][0-9]) ;;
        *) echo "slate-unlock: not a camera: $2" >&2; return 1 ;;
    esac
    case "$(readlink -f "$2")" in /dev/video[0-9]*) ;; *) echo "slate-unlock: not a camera: $2" >&2; return 1 ;; esac
    [ -c "$2" ] || { echo "slate-unlock: not a camera: $2" >&2; return 1; }
    "$1" set device_path "$2"
}
# Howdy's recognition models, when it hasn't any (they're large, and fetched from the internet)
models() { [ -n "$(ls -A "$HOWDY_MODELS" 2>/dev/null)" ] || "$1" download-models; }
face() {   # face <action> [arg] [arg]
    local howdy user
    howdy=$(howdy_bin) || { echo "slate-unlock: Howdy isn't installed" >&2; return 3; }
    case "$1" in
        face-camera) set_camera "$howdy" "$2" ;;
        face-models) models "$howdy" ;;
        face-add)
            [[ "$2" =~ ^[A-Za-z0-9][A-Za-z0-9\ _.-]{0,39}$ ]] || { echo "slate-unlock: a face's name is letters, numbers and spaces" >&2; return 1; }
            user=$(asker) || return 1
            if [ -n "${3:-}" ]; then set_camera "$howdy" "$3" || return 1; fi
            models "$howdy" || return 1
            "$howdy" -U "$user" add --plain -y "$2" || return 1
            "$howdy" -U "$user" list --plain || true ;;
        face-remove)
            [[ "$2" =~ ^[0-9]{1,9}$ ]] || { echo "slate-unlock: not a face's number: $2" >&2; return 1; }
            user=$(asker) || return 1
            "$howdy" -U "$user" remove -y "$2" || return 1
            "$howdy" -U "$user" list --plain || true ;;
        face-list)
            user=$(asker) || return 1
            # (none yet is Howdy's "abort": an empty list here)
            "$howdy" -U "$user" list --plain || true ;;
    esac
}
# The methods on now, as the file says
current() { [ -f "$FILE" ] && sed -n "s/^$MARK //p" "$FILE" | while read -r m _; do known "$m" && echo "$m"; done; }
# A method's line, from the first of its modules that's installed
line_for() {
    local file rest
    while read -r file rest; do
        [ -f "$file" ] && { echo "auth       sufficient   $rest"; return 0; }
    done < <(candidates "$1")
    return 1
}
# ---- The login screen ------------------------------------------------------------------------
login_current() { [ -f "$LOGIN_FILE" ] && sed -n "s/^$MARK //p" "$LOGIN_FILE" | while read -r m _; do known "$m" && echo "$m"; done; }
# A method's line for the login screen: the lock screen's, the fingerprint given one short try
# (the password waits behind it)
login_line_for() {
    local l
    l=$(line_for "$1") || return 1
    [ "$1" = fingerprint ] && l="$l max-tries=1 timeout=10"
    echo "$l"
}
# greetd's config is Slate's login screen's (slate-greeter-install wrote it)
slates_greetd() { [ -f "$GREETD_CONF" ] && [ ! -L "$GREETD_CONF" ] && head -1 "$GREETD_CONF" | grep -q '^# Slate login screen'; }
write_login() {
    local m tmp base=login
    [ -f "$PAMD/greetd" ] && base=greetd
    tmp=$(mktemp "$PAMD/.slate-greetd.XXXXXX") || return 1
    {
        echo "#%PAM-1.0"
        echo "# Slate's login screen: greetd's own service ($base), with the ways in that are on put"
        echo "# first. Written by Slate (slate-unlock, from Settings → Security); with none on, it's"
        echo "# greetd's own. The password always works: it comes once these give up."
        echo "auth       requisite    pam_nologin.so"
        for m in $METHODS; do
            case " $* " in *" $m "*) ;; *) continue ;; esac
            echo "$MARK $m"
            login_line_for "$m" || { rm -f "$tmp"; echo "slate-unlock: $m isn't installed" >&2; return 3; }
        done
        echo "auth       include      $base"
        echo "account    include      $base"
        echo "password   include      $base"
        echo "session    include      $base"
    } > "$tmp" || { rm -f "$tmp"; return 1; }
    chown root:root "$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$LOGIN_FILE" || { rm -f "$tmp"; return 1; }
}
# Slate's greetd config uses it (once the file's there, so greetd never names a service that
# isn't): a [general] service line, added once
point_greetd() {
    local tmp
    grep -q '^service[[:space:]]*=[[:space:]]*"slate-greetd"' "$GREETD_CONF" && return 0
    tmp=$(mktemp "$(dirname "$GREETD_CONF")/.config.toml.XXXXXX") || return 1
    if grep -q '^\[general\]' "$GREETD_CONF"; then
        # (a [general] of its own already: the line goes in it, as a second would break the file)
        sed '/^\[general\]/a service = "slate-greetd"' "$GREETD_CONF" > "$tmp"
    else
        { cat "$GREETD_CONF"; printf '\n[general]\nservice = "slate-greetd"\n'; } > "$tmp"
    fi
    chmod 0644 "$tmp" && mv -f "$tmp" "$GREETD_CONF" || { rm -f "$tmp"; return 1; }
}

# Write the file for these methods (none: take it away), all at once
write() {
    local m tmp
    if [ "$#" -eq 0 ]; then rm -f "$FILE"; return 0; fi
    tmp=$(mktemp "$PAMD/.slate-lock.XXXXXX") || return 1
    {
        echo "#%PAM-1.0"
        echo "# Unlocking Slate's lock screen without the password: written by Slate (slate-unlock)."
        echo "# Settings → Security changes it; nothing else on this computer reads it. Remove the file"
        echo "# and the lock screen takes only the password again."
        for m in $METHODS; do
            case " $* " in *" $m "*) ;; *) continue ;; esac
            echo "$MARK $m"
            line_for "$m" || { rm -f "$tmp"; echo "slate-unlock: $m isn't installed" >&2; return 3; }
        done
        echo "auth       required     pam_deny.so"
        echo "account    include      login"
    } > "$tmp" || { rm -f "$tmp"; return 1; }
    chown root:root "$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$FILE" || { rm -f "$tmp"; return 1; }
}

case "${1:-}" in
    enable|disable)
        [ "$#" -eq 2 ] || { echo "slate-unlock: $1 takes one method ($METHODS)" >&2; exit 1; }
        known "$2" || { echo "slate-unlock: no method called $2 ($METHODS)" >&2; exit 1; }
        if [ "$1" = enable ]; then
            line_for "$2" >/dev/null || { echo "slate-unlock: $2 isn't installed" >&2; exit 3; }
            mapfile -t on < <(current; echo "$2")
        else
            mapfile -t on < <(current | grep -vx "$2")
        fi
        # (each once: the file's order is METHODS', whatever order they came in)
        mapfile -t on < <(printf '%s\n' "${on[@]}" | grep -v '^$' | sort -u)
        write "${on[@]}"
        exit $? ;;
    login-enable|login-disable)
        [ "$#" -eq 2 ] || { echo "slate-unlock: $1 takes one method ($METHODS)" >&2; exit 1; }
        known "$2" || { echo "slate-unlock: no method called $2 ($METHODS)" >&2; exit 1; }
        slates_greetd || { echo "slate-unlock: Slate's login screen isn't installed" >&2; exit 4; }
        if [ "$1" = login-enable ]; then
            line_for "$2" >/dev/null || { echo "slate-unlock: $2 isn't installed" >&2; exit 3; }
            mapfile -t on < <(login_current; echo "$2")
        else
            mapfile -t on < <(login_current | grep -vx "$2")
        fi
        mapfile -t on < <(printf '%s\n' "${on[@]}" | grep -v '^$' | sort -u)
        [ ! -L "$LOGIN_FILE" ] && { [ ! -e "$LOGIN_FILE" ] || [ -f "$LOGIN_FILE" ]; } || {
            echo "slate-unlock: $LOGIN_FILE isn't a plain file: not touching it" >&2; exit 1; }
        write_login "${on[@]}" || exit $?
        point_greetd
        exit $? ;;
    face-camera|face-remove)
        [ "$#" -eq 2 ] || { echo "slate-unlock: $1 takes one more thing" >&2; exit 1; }
        face "$1" "$2"
        exit $? ;;
    face-add)
        [ "$#" -eq 2 ] || [ "$#" -eq 3 ] || { echo "slate-unlock: face-add takes a name, and a camera if you like" >&2; exit 1; }
        face "$@"
        exit $? ;;
    key-add|key-remove)
        [ "$#" -eq 2 ] || { echo "slate-unlock: $1 takes one more thing" >&2; exit 1; }
        key "$1" "$2"
        exit $? ;;
    key-list)
        [ "$#" -eq 1 ] || { echo "slate-unlock: key-list takes nothing else" >&2; exit 1; }
        key "$1"
        exit $? ;;
    face-models|face-list)
        [ "$#" -eq 1 ] || { echo "slate-unlock: $1 takes nothing else" >&2; exit 1; }
        face "$1"
        exit $? ;;
    remove)
        [ "$#" -eq 1 ] || { echo "slate-unlock: remove takes nothing else" >&2; exit 1; }
        write || exit $?
        # (the login screen's back to greetd's own: the file stays, as greetd may be using it)
        if [ -f "$LOGIN_FILE" ] && [ ! -L "$LOGIN_FILE" ]; then write_login || exit $?; fi
        # (Slate's list of security keys too, and its folder once empty)
        if [ -f "$KEYS" ] && [ ! -L "$KEYS" ]; then rm -f "$KEYS"; fi
        rmdir "$(dirname "$KEYS")" 2>/dev/null
        exit 0 ;;
    *)
        echo "slate-unlock: enable <method>, disable <method>, remove, status, face-… or key-…" >&2; exit 1 ;;
esac
