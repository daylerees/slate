#!/bin/sh
# Puts Slate back as it was when first installed (Settings → Debug → Factory reset): every
# setting back to its default, and everything Slate remembers forgotten (dock pins, launcher
# history, notifications, clipboard history, saved Spaces, the display layout, app theming).
# Nothing is deleted: it's all moved into a dated folder in ~/.local/share/slate/backups, so it
# can be put back by hand. Your own files (hypr/*.lua, user/shell.qml) aren't touched, unless
# asked for with --user-files: then they're moved to the backup too, and replaced with the blank
# ones Slate starts with (data/user-files).
#   slate-factory-reset [--user-files]
#
# Slate is stopped first, so it can't write its settings straight back, and started again
# afterwards. Prints the backup folder.
set -u
userFiles=false
[ "${1:-}" = "--user-files" ] && userFiles=true
SLATE_DIR=$(cd "$(dirname "$0")/.." && pwd)
SLATE_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/slate"     # your own files (Config.qml's userDir)
state="${XDG_STATE_HOME:-$HOME/.local/state}/slate"
share="${XDG_DATA_HOME:-$HOME/.local/share}/slate"
backup="$share/backups/factory-reset-$(date +%Y-%m-%d-%H%M%S)"
# (yours alone: it holds your settings, clipboard history, notifications and chats)
(umask 077; mkdir -p "$backup/state") || exit 1

# Unlocking without the password (a face, a fingerprint, a key) is a file root owns
# (/etc/pam.d/slate-lock): taken away with your password, asked for now, while Slate (which
# asks) is still running. Turned down, it stays, and Slate says so once it's back
unlock_kept=false
if [ -f /etc/pam.d/slate-lock ]; then
    "$SLATE_DIR/bin/slate-system" --root slate-unlock remove >/dev/null 2>&1 || unlock_kept=true
fi

"$SLATE_DIR/bin/slate" stop
sleep 0.3

# The pointer and the code font in other apps are put back first, as switching them off would:
# otherwise their record is moved away below, and the next start finds what Slate wrote and
# adopts it back on. (Needs settings.json and the undo log, so before they're moved.)
python3 "$SLATE_DIR/scripts/apply-theme.py" --undo-own >/dev/null 2>&1

[ -e "$SLATE_HOME/settings.json" ] && mv "$SLATE_HOME/settings.json" "$backup/"
[ -e "$share/spaces.json" ] && mv "$share/spaces.json" "$backup/"
[ -d "$state" ] && find "$state" -mindepth 1 -maxdepth 1 -exec mv -t "$backup/state/" {} +
if $userFiles; then
    for d in hypr user; do [ -e "$SLATE_HOME/$d" ] && mv "$SLATE_HOME/$d" "$backup/"; done
    # Blank ones back before Hyprland reloads, since its config loads them
    sh "$SLATE_DIR/scripts/user-files.sh" "$SLATE_HOME" >/dev/null
fi

# Hyprland drops the display layout, title bar colours and shortcut set Slate had written
hyprctl reload >/dev/null 2>&1
"$SLATE_DIR/bin/slate" start
if $unlock_kept; then
    ( sleep 6; notify-send -a Slate -i "$SLATE_DIR/assets/icon/icon-64.png" -- "Unlocking without your password is still on" \
        "Slate couldn't turn off unlocking with your face, a fingerprint or a key. You can turn each off in Settings → Security." ) &
fi
echo "$backup"
