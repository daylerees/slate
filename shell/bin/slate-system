#!/usr/bin/env bash
# Keep the parts of Slate that live outside your home in step with it: the packages it needs,
# the login session and Slate's own root helpers (all need your password to change).
#   slate-system --check            what's out of date, one per line: "package <name>", "helpers"
#                                   or "session"
#   slate-system --prompt           if anything is, offer to fix it: a notification with an
#                                   Install button, then your password. Asks once for each set
#                                   of changes ("Later" waits a week). Slate runs this.
#   slate-system --fix [--packages] fix it now (asks for your password); --packages: only the
#                                   packages (the updater does those before installing a version)
#   slate-system --upgrade          the distro's full system upgrade (asks for an administrator's
#                                   password): Slate Software's system updates
#   slate-system --install <pkg>…   install these packages from the distro's repositories (asks
#                                   for your password); Settings → App Theming's Install buttons
#   slate-system --root <helper> …  run one of Slate's root helpers (asks for your password):
#                                   slate-session-install, slate-greeter-install,
#                                   slate-private-camera, slate-update-install, slate-firewall or
#                                   slate-unlock, with its own arguments
# Nothing here runs as root itself, and nothing in your Slate folder is run as root: the root
# helpers are root-owned copies in /usr/local/libexec/slate (bin/slate-helpers-install puts
# them there, and is the one exception: it runs from here, with your password, when they're
# missing or a version has changed them).
# The packages are the required ones in packaging/<distro>.txt; optional ones ("?") are left to
# ./install.sh. NixOS is left to your configuration (packaging/nixos.nix).
set -uo pipefail

SELF=$(readlink -f "$0")
SRC=$(dirname "$(dirname "$SELF")")          # the Slate folder this belongs to
ICON="$SRC/assets/icon/icon-64.png"

# The distro family, as install.sh works it out
family() {
    local id
    . /etc/os-release 2>/dev/null || true
    for id in ${ID:-} ${ID_LIKE:-}; do
        case "$id" in
            artix) echo artix; return ;;         # (like Arch, without systemd: its own list)
            void) echo void; return ;;
            gentoo) echo gentoo; return ;;       # (listed, never installed for you: emerge is yours)
            arch|cachyos|endeavouros|manjaro|garuda) echo arch; return ;;
            debian|ubuntu|linuxmint|pop|elementary|zorin) echo debian; return ;;
            fedora|rhel|centos|nobara|ultramarine) echo fedora; return ;;
            opensuse*|suse|sles) echo opensuse; return ;;
            nixos) echo nixos; return ;;
        esac
    done
}
FAMILY=$(family)

# packaging/ is copied into an installed Slate; next to shell/ in a checkout or a release
LISTS=""
for d in "$SRC/packaging" "$SRC/../packaging"; do [ -d "$d" ] && { LISTS=$(readlink -f "$d"); break; }; done

# The list's lines, without comments: packages, "?optional" and (Fedora) "copr:owner/project"
read_list() { [ -f "$LISTS/$FAMILY.txt" ] && grep -v '^\s*\(#\|$\)' "$LISTS/$FAMILY.txt" | sed 's/\s*#.*//; s/\s*$//'; }

missing_packages() {
    local p
    read_list | while read -r p; do
        case "$p" in \?*|copr:*|"") continue ;; esac
        case "$FAMILY" in
            arch|artix) pacman -T "$p" >/dev/null 2>&1 || echo "$p" ;;
            void) xbps-query "$p" >/dev/null 2>&1 || echo "$p" ;;
            debian) dpkg -s "$p" 2>/dev/null | grep -q '^Status:.* installed' || echo "$p" ;;
            fedora|opensuse) rpm -q --whatprovides "$p" >/dev/null 2>&1 || echo "$p" ;;
        esac
    done
}

# The login session (slate-session-install) is out of date when it's installed and its
# script differs from this Slate's, comments aside
session_outdated() {
    local bin=/usr/local/bin/slate-session new="$SRC/session/slate-session"
    [ -f "$bin" ] && [ -f "$new" ] || return 1
    ! cmp -s <(grep -v '^\s*#' "$bin") <(grep -v '^\s*#' "$new")
}

# Slate's root helpers, the root-owned copies in /usr/local/libexec/slate: "current" when they
# match this Slate's, else "outdated" or "missing" (bin/slate-helpers-install --check, which
# only compares). NixOS has none: what they'd do is in its configuration.
HELPERS=/usr/local/libexec/slate
helpers_state() { "$SRC/bin/slate-helpers-install" --check "$SRC" 2>/dev/null || echo missing; }
helpers_outdated() { [ "$FAMILY" != nixos ] && [ "$(helpers_state)" != current ]; }

check() {
    local only_packages=${1:-0}
    missing_packages | sed 's/^/package /'
    [ "$only_packages" -eq 1 ] || { helpers_outdated && echo helpers; session_outdated && echo session; }
    return 0
}

# ---- Running something as root, with your password ----------------------------------------
# Only ever a root-owned copy in $HELPERS, never a script in your Slate folder: anything
# running as you could have changed those, and would only have to wait for the next prompt.
#   as_root [<helper> <arguments…>]
# When the copies there are missing, or this version has changed them, they're brought up to
# date first by bin/slate-helpers-install, which then runs the helper from there itself, so
# it's still one password. That is the one script of Slate's that root runs from your folder.
as_root() {
    # (NixOS has nowhere for them: said before any password is asked for)
    [ "$FAMILY" != nixos ] || { echo "slate-system: on NixOS, add it to your configuration" >&2; return 3; }
    command -v pkexec >/dev/null || { echo "slate-system: pkexec isn't installed (it comes with polkit)" >&2; return 1; }
    if [ "$(helpers_state)" != current ]; then pkexec "$SRC/bin/slate-helpers-install" "$SRC" "$@"
    elif [ "$#" -gt 0 ]; then pkexec "$HELPERS/$1" "${@:2}"; fi
}

# ---- fix: everything --check lists, with one password -------------------------------------
fix() {   # fix <only packages: 0/1>
    local args=() kind name helpers=0
    while read -r kind name; do
        # (the session's installer is told which Slate folder this is: it isn't ~/.config/slate
        # when XDG_CONFIG_HOME is set)
        case "$kind" in package) args+=("$name") ;; session) args+=("--session=$SRC") ;; helpers) helpers=1 ;; esac
    done < <(check "$1")
    # (as_root brings the helpers up to date on the way, when they aren't)
    if [ "${#args[@]}" -gt 0 ]; then as_root slate-system-root "${args[@]}"
    elif [ "$helpers" -eq 1 ]; then as_root; fi
}

# ---- root: one of the root helpers, for Slate's own buttons and prompts ---------------------
root() {
    case "${1:-}" in
        slate-session-install|slate-greeter-install|slate-private-camera|slate-update-install|slate-firewall|slate-unlock) as_root "$@" ;;
        *) echo "slate-system: --root takes slate-session-install, slate-greeter-install, slate-private-camera, slate-update-install, slate-firewall or slate-unlock" >&2; return 1 ;;
    esac
}

# ---- install: packages named by Settings (an app to theme), with your password -------------
install() {
    [ "$#" -gt 0 ] || { echo "slate-system: --install needs package names" >&2; return 1; }
    local p
    for p in "$@"; do
        [[ "$p" =~ ^[A-Za-z0-9][A-Za-z0-9@._+-]*$ ]] || { echo "slate-system: bad package name: $p" >&2; return 1; }
    done
    case "$FAMILY" in
        # (every family the root half, bin/slate-system-root, can install for)
        arch|artix|void|debian|fedora|opensuse) ;;
        nixos) echo "slate-system: on NixOS, add it to your configuration" >&2; return 1 ;;
        *) echo "slate-system: don't know how to install packages here" >&2; return 1 ;;
    esac
    as_root slate-system-root "$@"
}

# ---- upgrade: the whole system's updates, with an administrator's password (Slate Software) ---
upgrade() {
    case "$FAMILY" in
        arch|artix|void|debian|fedora|opensuse) ;;
        nixos) echo "slate-system: on NixOS, your configuration updates the system" >&2; return 1 ;;
        *) echo "slate-system: don't know how to update this system" >&2; return 1 ;;
    esac
    as_root slate-system-root --upgrade
}

case "${1:-}" in
    --check) check; exit 0 ;;
    --upgrade) upgrade; exit $? ;;
    --install) shift; install "$@"; exit $? ;;
    --fix) [ "${2:-}" = --packages ] && only=1 || only=0; fix "$only"; exit $? ;;
    --root) shift; root "$@"; exit $? ;;
    --prompt) ;;
    *) sed -n '2,/^set /{/^set /d;p}' "$SELF" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

# ---- prompt -------------------------------------------------------------------------------
todo=$(check)
[ -n "$todo" ] || exit 0
state="${XDG_STATE_HOME:-$HOME/.local/state}/slate"
asked="$state/system-asked"; snooze="$state/system-later"
[ "$(date +%s)" -lt "$(cat "$snooze" 2>/dev/null || echo 0)" ] && exit 0
version=$(printf '%s\n' "$todo" | md5sum | cut -d' ' -f1)
[ "$(cat "$asked" 2>/dev/null)" = "$version" ] && exit 0
mkdir -p "$state"; echo "$version" > "$asked"

pkgs=$(printf '%s\n' "$todo" | sed -n 's/^package //p' | paste -sd ' ' | sed 's/ /, /g')
if [ -n "$pkgs" ]; then
    title="Slate needs some packages"
    body="This version of Slate needs: $pkgs."
    printf '%s\n' "$todo" | grep -qx session && body="$body The login session has changed too."
elif printf '%s\n' "$todo" | grep -qx session; then
    title="Login session out of date"
    body="This version of Slate changes the Slate session on the login screen."
else
    # Only the root helpers: said plainly, since this is the one time something from your
    # Slate folder is run with your password
    title="Slate's helpers need updating"
    body="Slate keeps the helpers that make system changes for it (packages, the login session, the camera switch) in a folder only root can change. This version's need copying there from your Slate folder."
fi
if printf '%s\n' "$todo" | grep -qx helpers && [ "$todo" != helpers ]; then
    body="$body Slate's helpers for system changes are updated from your Slate folder too."
fi
# Critical, as the login screen's prompt is: it stays until answered, shows through Do Not
# Disturb and plays the attention sound
choice=$(notify-send -a Slate -i "$ICON" -u critical -h string:x-slate-page:updates -A install=Install -A later=Later \
    "$title" "$body Install now? You'll be asked for your password." || true)
if [ "$choice" != install ]; then
    echo $(( $(date +%s) + 7 * 24 * 3600 )) > "$snooze"      # not now: ask again in a week
    exit 0
fi
rm -f "$snooze"
id=$(notify-send -a Slate -i "$ICON" -p -h string:x-slate-page:updates "Installing…" "Slate is bringing your system up to date." || true)
replace=(); [ -n "$id" ] && replace=(-r "$id")
if fix 0 >/dev/null 2>&1; then
    if [ -n "$pkgs" ]; then done_body="Restart Slate to use them (run: slate restart)."
    elif printf '%s\n' "$todo" | grep -qx session; then done_body="You'll see it at your next login."
    else done_body="Slate's helpers are up to date."; fi
    notify-send -a Slate -i "$ICON" "${replace[@]}" -h string:x-slate-page:updates "Installed" "$done_body"
else
    rm -f "$asked"      # cancelled or failed: ask again next time
    names=$(printf '%s\n' "$todo" | sed -n 's/^package //p' | paste -sd ' ')
    case "$FAMILY" in
        arch|artix) cmd="sudo pacman -S --needed $names" ;; void) cmd="sudo xbps-install -S $names" ;;
        debian) cmd="sudo apt install $names" ;;
        fedora) cmd="sudo dnf install $names" ;; opensuse) cmd="sudo zypper install $names" ;; *) cmd="" ;;
    esac
    [ -n "$names" ] || cmd=""
    # (the helpers first: by hand, with sudo, is the same one step Slate's prompt takes)
    printf '%s\n' "$todo" | grep -qx helpers && cmd="${cmd:+$cmd; }sudo $SRC/bin/slate-helpers-install $SRC"
    printf '%s\n' "$todo" | grep -qx session && cmd="${cmd:+$cmd; }sudo $HELPERS/slate-session-install $SRC"
    # (no command Slate knows for this system: leave the line out rather than end on "run:")
    hint=""; [ -n "$cmd" ] && hint="To finish by hand, run: $cmd"
    notify-send -a Slate -i "$ICON" "${replace[@]}" -u critical -h string:x-slate-page:updates "Not installed" \
        "$hint"
fi
exit 0
