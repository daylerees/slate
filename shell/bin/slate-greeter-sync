#!/usr/bin/env bash
# Keep the Slate login screen's appearance in step with your desktop, without sudo.
# Copies data only (no code) into /var/lib/slate-greeter, which the "greeter" user
# can read: your Slate settings, the current wallpaper, avatar, name, session and
# interface font. Slate runs this automatically when the wallpaper or settings change.
#
# The login screen's code is a root-owned copy in /usr/local/share/slate-greeter,
# installed/updated by slate-greeter-install (Settings → Security, or ./install.sh --login-screen)
#
#   slate-greeter-sync           update the appearance
#   slate-greeter-sync --check   report whether the installed code matches yours
#   slate-greeter-sync --prompt  if the code is out of date, offer to update it (a
#                                notification with an Update button, then your password).
#                                Asks once per version of the code. Slate runs this.
#   slate-greeter-sync --status  what Settings needs to offer installing it, one key=value a line:
#                                state (as --check), greetd (yes/no: installed), dm (the
#                                login manager that's running, none or unknown), enable (the
#                                command that switches greetd on here), switch (the one that
#                                switches from another login manager to it), used (yes/no:
#                                greetd's config starts Slate's), backup (yes/no: there's a
#                                setup to switch back to)
set -euo pipefail

GREETD_ETC="${SLATE_GREETD_ETC:-/etc/greetd}"               # overrides only for testing
DEST="${SLATE_GREETER_DIR:-/var/lib/slate-greeter}"      # overrides only for testing
CODE="${SLATE_GREETER_CODE:-/usr/local/share/slate-greeter}"
SRC=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)    # this Slate's code
YOURS="${XDG_CONFIG_HOME:-$HOME/.config}/slate"          # your own files: settings.json

# Files making up the login screen's code (greeter/files): <installed name> <source path>
code_files() {
    sed 's/#.*//' "$SRC/greeter/files" | awk -v src="$SRC" 'NF >= 2 && $1 != "-" && $1 != "+" { print $1, src "/" $2 }'
}
# The ones shared with the rest of Slate, which change with nearly every Slate change, mostly in
# ways the login screen doesn't notice: a change to only these doesn't ask for an update (it
# comes along with the next one, or Settings → Security → Update)
SHARED="Config.qml SettingsData.qml"
own_files() { code_files | while read -r name src; do case " $SHARED " in *" $name "*) ;; *) echo "$name $src" ;; esac; done; }

# Your keyboard layout, from the running Hyprland (the login screen uses the same one)
kb_layout() {
    local l
    l=$(hyprctl getoption input:kb_layout -j 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("str",""))' 2>/dev/null || true)
    case "$l" in ""|"[[EMPTY]]") l=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("kb_layout",""))' "$DEST/user.json" 2>/dev/null || true) ;; esac
    echo "${l:-us}"
}
# The installed hyprland.lua has your keyboard layout filled in
hypr_expected() {
    sed "s/__KB_LAYOUT__/$(kb_layout)/" "$SRC/greeter/hyprland.lua"
}
state() {
    [ -d "$CODE" ] || { echo "not-installed"; return; }
    while read -r name src; do
        cmp -s "$src" "$CODE/$name" || { echo "outdated"; return; }
    done < <(code_files)
    hypr_expected | cmp -s - "$CODE/hyprland.lua" || { echo "outdated"; return; }
    echo "current"
}

if [ "${1:-}" = "--check" ]; then state; exit 0; fi

# Whether greetd is set to start Slate's login screen (not switched back with --revert)
in_use() { grep -qs "slate-greeter" "$GREETD_ETC/config.toml"; }

if [ "${1:-}" = "--status" ]; then
    echo "state=$(state)"
    if command -v greetd >/dev/null 2>&1 || [ -x /usr/bin/greetd ] || [ -x /usr/sbin/greetd ]; then echo "greetd=yes"; else echo "greetd=no"; fi
    # (which login manager runs, and the command that switches greetd on: bin/slate-init,
    # which knows systemd and the init systems used without it)
    dm=$("$SRC/bin/slate-init" display-manager 2>/dev/null || echo unknown)
    echo "dm=$dm"
    echo "enable=$("$SRC/bin/slate-init" service-hint greetd 2>/dev/null || true)"
    case "$dm" in none|greetd|unknown) echo "switch=" ;; *) echo "switch=$("$SRC/bin/slate-init" service-swap-hint "$dm" greetd 2>/dev/null || true)" ;; esac
    if in_use; then echo "used=yes"; else echo "used=no"; fi
    if [ -f "$GREETD_ETC/config.toml.before-slate" ]; then echo "backup=yes"; else echo "backup=no"; fi
    exit 0
fi

# Whether the login screen's own code (not the shared files) or its keyboard layout has changed.
# Takes the expected hyprland.lua (hypr_expected), so it's worked out once
own_outdated() {   # own_outdated <expected hyprland.lua>
    [ -d "$CODE" ] || return 1
    while read -r name src; do
        cmp -s "$src" "$CODE/$name" || return 0
    done < <(own_files)
    printf '%s\n' "$1" | cmp -s - "$CODE/hyprland.lua" || return 0
    return 1
}

if [ "${1:-}" = "--prompt" ]; then
    # Only for the login screen's own changes (see SHARED); --check still reports any change
    expected=$(hypr_expected)
    # Up to date (updated from Settings, say): a "Later" from before no longer holds, so the
    # next change is asked about. (It used to stay for its week, and that change went unasked)
    own_outdated "$expected" || { rm -f "${XDG_STATE_HOME:-$HOME/.local/state}/slate/greeter-later"; exit 0; }
    in_use || exit 0              # switched back to another login screen: nothing to keep up to date
    # Ask once per version of its own code; "Later" (or dismissing it) waits a week
    asked="${XDG_STATE_HOME:-$HOME/.local/state}/slate/greeter-asked"
    snooze="${XDG_STATE_HOME:-$HOME/.local/state}/slate/greeter-later"
    [ "$(date +%s)" -lt "$(cat "$snooze" 2>/dev/null || echo 0)" ] && exit 0
    version=$( { while read -r _ src; do cat "$src"; done < <(own_files); printf '%s\n' "$expected"; } | md5sum | cut -d' ' -f1)
    [ "$(cat "$asked" 2>/dev/null)" = "$version" ] && exit 0
    mkdir -p "$(dirname "$asked")"; echo "$version" > "$asked"
    icon="$SRC/assets/icon/icon-64.png"      # Slate's own icon, as its other notices use
    # Critical: it stays until answered, shows through Do Not Disturb and plays the attention sound
    choice=$(notify-send -a Slate -i "$icon" -u critical -h string:x-slate-page:lock -A update=Update -A later=Later \
        "Login screen out of date" \
        "Its design has changed. Update it now? You'll be asked for your password." || true)
    if [ "$choice" != update ]; then
        echo $(( $(date +%s) + 7 * 24 * 3600 )) > "$snooze"     # not now: ask again in a week
        exit 0
    fi
    rm -f "$snooze"
    # (the root-owned copy of the installer, never the one in your Slate folder: slate-system)
    if "$SRC/bin/slate-system" --root slate-greeter-install --code-only; then
        notify-send -a Slate -i "$icon" -h string:x-slate-page:lock "Login screen updated" "You'll see it at your next logout or restart."
    else
        rm -f "$asked"      # cancelled or failed: ask again next time
        # Critical too: it says how to finish the update by hand, so it stays until read
        notify-send -a Slate -i "$icon" -u critical -h string:x-slate-page:lock "Login screen not updated" "Your current login screen stays as it is. Try again from Settings → Security, or in a terminal run: $SRC/bin/slate-system --root slate-greeter-install --code-only"
    fi
    exit 0
fi

# Where your look goes: your own folder in the login screen's people/ (anyone can keep theirs
# there, nobody can touch anyone else's), and the shared look too when the login screen's folder
# is yours (you set it up). A folder of yours there has to be a real folder owned by you: one
# that isn't (a link, or someone else's) is left alone, and the login screen won't use it either
# (named by the account you really are, never by $USER, which anything can set)
ME=$(id -un)
PEOPLE="$DEST/people"
MINE="$PEOPLE/$ME"
mine_ok=0
if [ -d "$PEOPLE" ] && [ -w "$PEOPLE" ]; then
    if [ ! -e "$MINE" ] && [ ! -L "$MINE" ]; then mkdir -m 755 "$MINE" 2>/dev/null || true; fi
    [ -d "$MINE" ] && [ ! -L "$MINE" ] && [ "$(stat -c %U "$MINE")" = "$ME" ] && mine_ok=1
fi
shared_ok=0; [ -d "$DEST" ] && [ -w "$DEST" ] && shared_ok=1
if [ "$shared_ok" = 0 ] && [ "$mine_ok" = 0 ]; then
    echo "slate-greeter-sync: $DEST isn't set up yet; install it from Settings → Security, or with: ./install.sh --login-screen" >&2
    exit 1
fi

# Copy into place via a temporary file + rename, so the greeter never sees half a file. A file
# that's already the same is left alone: this runs after every settings change, and copying the
# wallpaper (many MB) and fonts again each time was wasted work
put() {   # put <source> <name in DEST>   (DEST, or a folder in it, as $into says)
    local to="${into:-$DEST}"
    cmp -s "$1" "$to/$2" && return 0
    local tmp="$to/.$(basename "$2").tmp"
    mkdir -p "$(dirname "$to/$2")"
    cp -f "$1" "$tmp" && chmod a+r "$tmp" && mv -f "$tmp" "$to/$2"
}
write() {  # write <name in DEST>  (contents on stdin; left alone when it's the same)
    local to="${into:-$DEST}"
    local tmp="$to/.$1.tmp"
    cat > "$tmp" || return 1
    if cmp -s "$tmp" "$to/$1"; then rm -f "$tmp"; return 0; fi
    chmod a+r "$tmp" && mv -f "$tmp" "$to/$1"
}

# Only how your desktop looks goes in, never the rest of your settings (where you are, your
# own commands…): the login screen's folder can be read by everyone on the computer. The settings
# it uses, by name; anything new stays out until it's added here
LOOK="accent accentFromWallpaper accentBoldness lightMode themeMode toneFromWallpaper toneBoldness colourStyle uiScale
      roundedScreenCorners roundedElements shadows shadowDarkness shadowSoftness shadowSpread shadowDistance
      shadowDirection animations fontFamily cursorTheme cursorSize lockScreenPowerMenu
      glass glassOpacity glassBlur glassGlossTint glassGloss fastBlur blurPasses"
look() {   # look <settings.json>: just those, as JSON
    python3 -c 'import json, sys
s = json.load(open(sys.argv[1]))
print(json.dumps({k: s[k] for k in sys.argv[2].split() if k in s}, indent=2))' "$1" "$LOOK"
}

# The wallpaper and interface font, from Slate's settings (one read for both)
{ read -r wall; read -r family; } < <(python3 -c 'import json,sys; s=json.load(open(sys.argv[1])); print(s.get("wallpaper","")); print(s.get("fontFamily","Geist") or "Geist")' "$YOURS/settings.json" 2>/dev/null || printf '\nGeist\n')
family=${family:-Geist}
avatar=""
for a in "/var/lib/AccountsService/icons/$ME" "$HOME/.face"; do [ -f "$a" ] && { avatar=$a; break; }; done

# Your look: settings, wallpaper (without it, plain slate) and picture, in each place it goes
for into in $([ "$mine_ok" = 1 ] && echo "$MINE") $([ "$shared_ok" = 1 ] && echo "$DEST"); do
    look "$YOURS/settings.json" | write settings.json || true
    if [ -n "$wall" ] && [ -f "$wall" ]; then put "$wall" wallpaper; else rm -f "$into/wallpaper"; fi
    if [ -n "$avatar" ]; then put "$avatar" avatar; else rm -f "$into/avatar"; fi
done
into=""
[ "$mine_ok" = 1 ] && chmod -R a+rX "$MINE"
if [ "$shared_ok" = 0 ]; then
    echo "slate-greeter-sync: your look on the login screen updated"
    exit 0
fi

# Who logs in, and the session they use now (Slate, uwsm-managed or plain Hyprland)
name=$(getent passwd "$ME" | cut -d: -f5 | cut -d, -f1)
if [ -n "${SLATE_SESSION:-}" ]; then session=slate
elif pgrep -u "$ME" -f 'uwsm/signal-handler' >/dev/null 2>&1; then session=hyprland-uwsm; else session=hyprland; fi
# (written as JSON by Python, laid out as it always was: a full name with a quote or a
# backslash in it used to make a file the login screen couldn't read)
python3 -c 'import json, sys
print("{ " + ", ".join(json.dumps(k) + ": " + json.dumps(v, ensure_ascii=False)
                       for k, v in zip(("user", "name", "session", "kb_layout"), sys.argv[1:])) + " }")' \
    "$ME" "${name:-$ME}" "$session" "$(kb_layout)" | write user.json

# Your displays, as your desktop shows them now, so the login screen starts each monitor the
# same way: a monitor changing mode goes black for a few seconds, and the login screen in its
# own mode meant that twice at every login (and a face recognized while it was black, the login
# screen never seen). One monitor a line, tab separated, by description as Settings → Displays
# keeps them: description, mode, scale, rotation, x, y, then HDR (on, off, auto, or nothing to
# leave it as Hyprland has it) and, with HDR on, its SDR brightness and saturation. Data only:
# greeter/hyprland.lua checks each field. Not run in Hyprland (no answer): left as it was
mons=$(hyprctl monitors -j 2>/dev/null || true)
displays=$(python3 -c 'import json, math, sys
try:
    mons = json.loads(sys.argv[1])
except ValueError:
    sys.exit(1)
try:
    saved = json.load(open(sys.argv[2]))
except (OSError, ValueError):
    saved = {}
if not isinstance(mons, list) or not isinstance(saved, dict):
    sys.exit(1)
lines = []
for m in mons:
    d = m.get("description") or ""
    if not d or m.get("disabled") or any(c in d for c in "\t\n\r"):
        continue
    s = saved.get(d) if isinstance(saved.get(d), dict) else {}
    hdr = s.get("hdr", "")
    if hdr not in ("on", "off", "auto") or (hdr != "on" and not s.get("hdrCapable")):
        hdr = ""
    f = [d, "%dx%d@%.2f" % (m["width"], m["height"], m["refreshRate"]), "%.6f" % m["scale"],
         str(m.get("transform", 0)), str(m["x"]), str(m["y"]), hdr]
    if hdr == "on":
        f += ["%.2f" % float(s.get("sdrBrightness", 1)), "%.2f" % float(s.get("sdrSaturation", 1))]
    lines.append("\t".join(f))
if not lines:
    sys.exit(1)
print("\n".join(lines))' "$mons" "${XDG_STATE_HOME:-$HOME/.local/state}/slate/displays.json" 2>/dev/null) \
    && printf '%s\n' "$displays" | write displays || true

# Fonts: your interface font's files (system fonts are already readable, so not those), the
# icon font and the bundled Geist. Only what's changed is copied, and only fonts no longer
# wanted are removed
mkdir -p "$DEST/fonts"
declare -A wanted=([tabler.ttf]=1)
while read -r f; do
    case "$f" in /usr/share/*|"") ;; *) [ -f "$f" ] && { put "$f" "fonts/$(basename "$f")"; wanted[$(basename "$f")]=1; } ;; esac
done < <(fc-list --format '%{file}\n' ":family=$family" 2>/dev/null | sort -u)
put "$SRC/fonts/tabler.ttf" fonts/tabler.ttf
for f in "$SRC"/fonts/Geist*-Variable.ttf; do [ -f "$f" ] && { put "$f" "fonts/$(basename "$f")"; wanted[$(basename "$f")]=1; }; done
for f in "$DEST"/fonts/*; do
    [ -f "$f" ] && [ -z "${wanted[$(basename "$f")]:-}" ] && rm -f "$f"
done

# All of it readable by the login screen, except people/: that's root's (each person keeps their
# own folder in it, opened up above), and neither it nor anyone else's folder there is yours to
# change (opening up the whole folder made installing the login screen fail)
chmod a+rX "$DEST"
for f in "$DEST"/* "$DEST"/.[!.]*; do
    [ -e "$f" ] && [ ! -L "$f" ] || continue        # (never through a link: -R from above didn't)
    [ "$f" = "$PEOPLE" ] && continue
    chmod -R a+rX "$f"
done
echo "slate-greeter-sync: login screen appearance updated"
