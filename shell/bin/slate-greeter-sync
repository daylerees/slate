#!/usr/bin/env bash
# Keep the Slate login screen's appearance in step with your desktop, without sudo.
# Copies data only (no code) into /var/lib/slate-greeter, which the "greeter" user
# can read: your Slate settings, the current wallpaper, avatar, name, session and
# interface font. Slate runs this automatically when the wallpaper or settings change.
#
# The login screen's code is a root-owned copy in /usr/local/share/slate-greeter,
# installed/updated with:  sudo ~/.config/slate/bin/slate-greeter-install
#
#   slate-greeter-sync           update the appearance
#   slate-greeter-sync --check   report whether the installed code matches yours
#   slate-greeter-sync --prompt  if the code is out of date, offer to update it (a
#                                notification with an Update button, then your password).
#                                Asks once per version of the code. Slate runs this.
#   slate-greeter-sync --status  what Settings needs to offer installing it, one key=value a line:
#                                state (as --check), greetd (yes/no: installed), dm (the
#                                login manager that's running, none or unknown), enable (the
#                                command that switches greetd on here), switch (the one that
#                                switches from another login manager to it), used (yes/no:
#                                greetd's config starts Slate's), backup (yes/no: there's a
#                                setup to switch back to)
set -euo pipefail

GREETD_ETC="${SLATE_GREETD_ETC:-/etc/greetd}"               # overrides only for testing
DEST="${SLATE_GREETER_DIR:-/var/lib/slate-greeter}"      # overrides only for testing
CODE="${SLATE_GREETER_CODE:-/usr/local/share/slate-greeter}"
SRC="$HOME/.config/slate"

# Files making up the login screen's code (greeter/files): <installed name> <source path>
code_files() {
    sed 's/#.*//' "$SRC/greeter/files" | awk -v src="$SRC" 'NF >= 2 && $1 != "-" && $1 != "+" { print $1, src "/" $2 }'
}
# The ones shared with the rest of Slate, which change with nearly every Slate change, mostly in
# ways the login screen doesn't notice: a change to only these doesn't ask for an update (it
# comes along with the next one, or Settings → Security → Update)
SHARED="Config.qml SettingsData.qml"
own_files() { code_files | while read -r name src; do case " $SHARED " in *" $name "*) ;; *) echo "$name $src" ;; esac; done; }

# Your keyboard layout, from the running Hyprland (the login screen uses the same one)
kb_layout() {
    local l
    l=$(hyprctl getoption input:kb_layout -j 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("str",""))' 2>/dev/null || true)
    case "$l" in ""|"[[EMPTY]]") l=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("kb_layout",""))' "$DEST/user.json" 2>/dev/null || true) ;; esac
    echo "${l:-us}"
}
# The installed hyprland.lua has your keyboard layout filled in
hypr_expected() {
    sed "s/__KB_LAYOUT__/$(kb_layout)/" "$SRC/greeter/hyprland.lua"
}
state() {
    [ -d "$CODE" ] || { echo "not-installed"; return; }
    while read -r name src; do
        cmp -s "$src" "$CODE/$name" || { echo "outdated"; return; }
    done < <(code_files)
    hypr_expected | cmp -s - "$CODE/hyprland.lua" || { echo "outdated"; return; }
    echo "current"
}

if [ "${1:-}" = "--check" ]; then state; exit 0; fi

# Whether greetd is set to start Slate's login screen (not switched back with --revert)
in_use() { grep -qs "slate-greeter" "$GREETD_ETC/config.toml"; }

if [ "${1:-}" = "--status" ]; then
    echo "state=$(state)"
    if command -v greetd >/dev/null 2>&1 || [ -x /usr/bin/greetd ] || [ -x /usr/sbin/greetd ]; then echo "greetd=yes"; else echo "greetd=no"; fi
    # (which login manager runs, and the command that switches greetd on: bin/slate-init,
    # which knows systemd and the init systems used without it)
    dm=$("$SRC/bin/slate-init" display-manager 2>/dev/null || echo unknown)
    echo "dm=$dm"
    echo "enable=$("$SRC/bin/slate-init" service-hint greetd 2>/dev/null || true)"
    case "$dm" in none|greetd|unknown) echo "switch=" ;; *) echo "switch=$("$SRC/bin/slate-init" service-swap-hint "$dm" greetd 2>/dev/null || true)" ;; esac
    if in_use; then echo "used=yes"; else echo "used=no"; fi
    if [ -f "$GREETD_ETC/config.toml.before-slate" ]; then echo "backup=yes"; else echo "backup=no"; fi
    exit 0
fi

# Whether the login screen's own code (not the shared files) or its keyboard layout has changed.
# Takes the expected hyprland.lua (hypr_expected), so it's worked out once
own_outdated() {   # own_outdated <expected hyprland.lua>
    [ -d "$CODE" ] || return 1
    while read -r name src; do
        cmp -s "$src" "$CODE/$name" || return 0
    done < <(own_files)
    printf '%s\n' "$1" | cmp -s - "$CODE/hyprland.lua" || return 0
    return 1
}

if [ "${1:-}" = "--prompt" ]; then
    # Only for the login screen's own changes (see SHARED); --check still reports any change
    expected=$(hypr_expected)
    own_outdated "$expected" || exit 0
    in_use || exit 0              # switched back to another login screen: nothing to keep up to date
    # Ask once per version of its own code; "Later" (or dismissing it) waits a week
    asked="${XDG_STATE_HOME:-$HOME/.local/state}/slate/greeter-asked"
    snooze="${XDG_STATE_HOME:-$HOME/.local/state}/slate/greeter-later"
    [ "$(date +%s)" -lt "$(cat "$snooze" 2>/dev/null || echo 0)" ] && exit 0
    version=$( { while read -r _ src; do cat "$src"; done < <(own_files); printf '%s\n' "$expected"; } | md5sum | cut -d' ' -f1)
    [ "$(cat "$asked" 2>/dev/null)" = "$version" ] && exit 0
    mkdir -p "$(dirname "$asked")"; echo "$version" > "$asked"
    icon="$SRC/assets/icon/icon-64.png"      # Slate's own icon, as its other notices use
    # Critical: it stays until answered, shows through Do Not Disturb and plays the attention sound
    choice=$(notify-send -a Slate -i "$icon" -u critical -h string:x-slate-page:lock -A update=Update -A later=Later \
        "Login screen out of date" \
        "Its design has changed. Update it now? You'll be asked for your password." || true)
    if [ "$choice" != update ]; then
        echo $(( $(date +%s) + 7 * 24 * 3600 )) > "$snooze"     # not now: ask again in a week
        exit 0
    fi
    rm -f "$snooze"
    if pkexec "$SRC/bin/slate-greeter-install" --code-only; then
        notify-send -a Slate -i "$icon" -h string:x-slate-page:lock "Login screen updated" "You'll see it at your next logout or restart."
    else
        rm -f "$asked"      # cancelled or failed: ask again next time
        # Critical too: it says how to finish the update by hand, so it stays until read
        notify-send -a Slate -i "$icon" -u critical -h string:x-slate-page:lock "Login screen not updated" "Run: sudo ~/.config/slate/bin/slate-greeter-install --code-only"
    fi
    exit 0
fi

if [ ! -d "$DEST" ] || [ ! -w "$DEST" ]; then
    echo "slate-greeter-sync: $DEST isn't set up yet; run: sudo ~/.config/slate/bin/slate-greeter-install" >&2
    exit 1
fi

# Copy into place via a temporary file + rename, so the greeter never sees half a file. A file
# that's already the same is left alone: this runs after every settings change, and copying the
# wallpaper (many MB) and fonts again each time was wasted work
put() {   # put <source> <name in DEST>
    cmp -s "$1" "$DEST/$2" && return 0
    local tmp="$DEST/.$(basename "$2").tmp"
    mkdir -p "$(dirname "$DEST/$2")"
    cp -f "$1" "$tmp" && chmod a+r "$tmp" && mv -f "$tmp" "$DEST/$2"
}
write() {  # write <name in DEST>  (contents on stdin)
    local tmp="$DEST/.$1.tmp"
    cat > "$tmp" && chmod a+r "$tmp" && mv -f "$tmp" "$DEST/$1"
}

# Theme settings (accent, light/dark, tint, fonts, rounded corners…)
put "$SRC/settings.json" settings.json

# The wallpaper and interface font, from Slate's settings (one read for both)
{ read -r wall; read -r family; } < <(python3 -c 'import json,sys; s=json.load(open(sys.argv[1])); print(s.get("wallpaper","")); print(s.get("fontFamily","Geist") or "Geist")' "$SRC/settings.json" 2>/dev/null || printf '\nGeist\n')
family=${family:-Geist}

# Wallpaper; without it the login screen uses plain slate
if [ -n "$wall" ] && [ -f "$wall" ]; then put "$wall" wallpaper; else rm -f "$DEST/wallpaper"; fi

# Avatar
for a in "/var/lib/AccountsService/icons/$USER" "$HOME/.face"; do
    if [ -f "$a" ]; then put "$a" avatar; break; fi
done

# Who logs in, and the session they use now (Slate, uwsm-managed or plain Hyprland)
name=$(getent passwd "$USER" | cut -d: -f5 | cut -d, -f1)
if [ -n "${SLATE_SESSION:-}" ]; then session=slate
elif pgrep -u "$USER" -f 'uwsm/signal-handler' >/dev/null 2>&1; then session=hyprland-uwsm; else session=hyprland; fi
printf '{ "user": "%s", "name": "%s", "session": "%s", "kb_layout": "%s" }\n' "$USER" "${name:-$USER}" "$session" "$(kb_layout)" | write user.json

# Fonts: your interface font's files (system fonts are already readable, so not those), the
# icon font and the bundled Geist. Only what's changed is copied, and only fonts no longer
# wanted are removed
mkdir -p "$DEST/fonts"
declare -A wanted=([tabler.ttf]=1)
while read -r f; do
    case "$f" in /usr/share/*|"") ;; *) [ -f "$f" ] && { put "$f" "fonts/$(basename "$f")"; wanted[$(basename "$f")]=1; } ;; esac
done < <(fc-list --format '%{file}\n' ":family=$family" 2>/dev/null | sort -u)
put "$SRC/fonts/tabler.ttf" fonts/tabler.ttf
for f in "$SRC"/fonts/Geist*-Variable.ttf; do [ -f "$f" ] && { put "$f" "fonts/$(basename "$f")"; wanted[$(basename "$f")]=1; }; done
for f in "$DEST"/fonts/*; do
    [ -f "$f" ] && [ -z "${wanted[$(basename "$f")]:-}" ] && rm -f "$f"
done

chmod -R a+rX "$DEST"
echo "slate-greeter-sync: login screen appearance updated"
