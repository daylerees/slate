#!/bin/sh
# Slate's pre-commit check. Turn it on once per clone:  git config core.hooksPath .githooks
#
# When a commit touches the login screen's code, checks its file list (shell/greeter/files)
# and test-loads it, so a change that would break the login screen is caught here rather
# than at the next reboot. Skip once with: git commit --no-verify
root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only -- shell/)
[ -n "$staged" ] || exit 0

# Any QML can become part of the login screen, so the file list is always checked (fast)
python3 "$root/tools/check-greeter-files" >/dev/null || { python3 "$root/tools/check-greeter-files"; exit 1; }

# The load test, when the login screen's own files change: those in greeter/files, the
# greeter folder and its helpers
watch=$(sed 's/#.*//' "$root/shell/greeter/files" | awk 'NF >= 2 && $1 != "+" { print "shell/" $2 }')
hit=$(echo "$staged" | while read -r f; do
    case "$f" in shell/greeter/*|shell/bin/slate-greeter-*) echo "$f" ;; *) echo "$watch" | grep -qxF "$f" && echo "$f" ;; esac
done)
[ -n "$hit" ] || exit 0
if ! command -v qs >/dev/null; then echo "pre-commit: qs not found; skipping the login screen load test"; exit 0; fi
"$root/shell/bin/slate-greeter-check" --source "$root/shell" >/dev/null 2>&1 || {
    echo "pre-commit: this would break the login screen (checked: your working copy)"
    "$root/shell/bin/slate-greeter-check" --source "$root/shell"
    exit 1
}
